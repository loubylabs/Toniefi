# Copy to .env next to docker-compose.yml. Every line is optional: the
# defaults run the app with its library in ./library beside the repo.

# --- myTonies account -------------------------------------------------
# You can also enter these on the Settings tab, though env vars keep them
# out of the database. Does not work with two-factor accounts.
TONIES_USERNAME=you@example.com
TONIES_PASSWORD=your-mytonies-password

# --- where things live ------------------------------------------------
# Absolute paths, or paths relative to this file. On Unraid, point these at
# your shares:
#   TONIEFI_LIBRARY=/mnt/user/media/toniefi
#   TONIEFI_DATA=/mnt/user/appdata/toniefi
#TONIEFI_LIBRARY=./library
#TONIEFI_DATA=./data

# --- host settings ----------------------------------------------------
# Only if 8080 is already taken.
#TONIEFI_PORT=8080
# Scratch space size. It is RAM, so keep it under what the Docker VM has.
#TONIEFI_WORK_SIZE=2g

# On plain Linux, set these to your own ids (run `id -u` and `id -g`) so
# files in the library belong to you and not to root. On Unraid that is
# usually 99 and 100. Leave unset on Docker Desktop.
#TONIEFI_UID=1000
#TONIEFI_GID=1000
